# F3.3 — một lượt reconciler GitOps + tự phục hồi của Mộc (scripts/reconcile.py). Tệp MẪU: sửa đường dẫn, người
# dùng cho đúng máy chủ rồi cài (README mục "GitOps và tự phục hồi"):
#
#   sudo cp ops/systemd/moc-reconcile.service ops/systemd/moc-reconcile.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now moc-reconcile.timer
#   journalctl -u moc-reconcile -f        # xem từng lượt
#
# Chạy trên máy chủ, không trong container: không gắn socket Docker vào container nào.

[Unit]
Description=Mộc — reconciler GitOps và tự phục hồi (một lượt)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# Người vận hành sở hữu thư mục cài (make install), thuộc nhóm docker; không chạy bằng root
User=moc
Group=docker
WorkingDirectory=/opt/moc
ExecStart=/usr/bin/python3 /opt/moc/scripts/reconcile.py
# Một lượt áp commit mới phải dựng image, cài lại, có khi cài lại commit cũ: từng bước trong reconcile.py đã có giới
# hạn thời gian riêng. systemd không giết giữa chừng (giết lúc đang cài là để lại bản cài dở dang)
TimeoutStartSec=infinity
# Tách khỏi phần còn lại của máy chủ những gì reconciler không cần
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
