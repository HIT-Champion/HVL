{
  "$comment": [
    "Ca thử dùng chung cho luật kiểm tệp form của ứng dụng lúc cài: check_form (svc_workflow/apps/forms.py, test",
    "test_app_forms.py) và bản chép trên trình duyệt (apps/office/app/utils/formRules.ts, tests/formRules.test.ts).",
    "Mỗi ca dựng tệp form từ base: set đặt giá trị theo JSON Pointer (\"\" là cả tệp), unset xóa khóa; hoặc text là",
    "nội dung tệp, ghép từ các phần. Giá trị {\"$repeat\": s, \"times\": n} là chuỗi s lặp n lần; {\"$nest\": k,",
    "\"times\": n, \"leaf\": v} là v bọc n lần trong {k: …}. errors: mã các luật bị vi phạm, không kể thứ tự; valid",
    "thì không có lỗi nào. Hai luật trong serverOnly chỉ máy chủ kiểm, trình duyệt bỏ qua. constants: hằng số hai",
    "bên phải giống hệt, tên như trong forms.py."
  ],
  "rules": [
    "size", "json", "depth", "root", "draft", "root-type", "additional-properties", "properties", "reserved",
    "engine-name", "field-name", "field-schema", "scalar", "enum", "x-moc-date", "required", "x-moc-range",
    "root-only", "ref-external", "dynamic-ref", "format", "pattern-properties", "ref-target", "ref-loop", "steps",
    "pattern", "schema"
  ],
  "serverOnly": ["pattern", "schema"],
  "constants": {
    "DRAFT": "https://json-schema.org/draft/2020-12/schema",
    "RESERVED": ["tenantId", "departmentId", "initiator"],
    "ENGINE_NAMES": ["execution", "task", "authenticatedUserId", "currentTenantId"],
    "VARIABLE": "[a-z][A-Za-z0-9]{0,63}",
    "SCALAR_TYPES": ["boolean", "integer", "null", "number", "string"],
    "FORMATS": ["date", "uuid"],
    "DATE_RULES": ["not-after-today", "not-before-today"],
    "MAX_FORM_BYTES": 262144,
    "MAX_DEPTH": 32,
    "MAX_REF_DEPTH": 16,
    "NODE_STEPS": 3000,
    "MAX_FORM_STEPS": 30000000,
    "ROOT_ONLY": ["$id", "$anchor", "$dynamicAnchor", "$recursiveAnchor"],
    "SUBSCHEMA": ["not", "if", "then", "else", "items", "contains", "additionalProperties", "propertyNames",
                  "unevaluatedItems", "unevaluatedProperties"],
    "SUBSCHEMA_LISTS": ["allOf", "anyOf", "oneOf", "prefixItems"],
    "SUBSCHEMA_MAPS": ["properties", "patternProperties", "dependentSchemas"]
  },
  "base": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:moc:app:vpp:form:de-nghi",
    "title": "Đề nghị cấp văn phòng phẩm",
    "x-moc-title": {"vi": "Đề nghị cấp văn phòng phẩm", "en": "Stationery request"},
    "x-moc-order": ["hang", "soLuong", "tuNgay", "denNgay", "ghiChu", "maPhieu", "duyetGap"],
    "x-moc-range": [["tuNgay", "denNgay"]],
    "x-moc-nfc": true,
    "type": "object",
    "additionalProperties": false,
    "required": ["hang", "soLuong", "tuNgay"],
    "properties": {
      "hang": {
        "enum": ["but", "giay", "muc"],
        "x-moc-ui": {"label": {"vi": "Hàng", "en": "Item"}}
      },
      "soLuong": {"type": "integer", "minimum": 1, "maximum": 100},
      "tuNgay": {"type": "string", "format": "date", "x-moc-date": "not-before-today"},
      "denNgay": {"type": "string", "format": "date"},
      "ghiChu": {
        "type": "string",
        "maxLength": 500,
        "$ref": "#/$defs/text",
        "x-moc-ui": {"widget": "textarea", "label": {"vi": "Ghi chú", "en": "Note"}}
      },
      "maPhieu": {"type": "string", "format": "uuid"},
      "duyetGap": {"type": ["boolean", "null"]}
    },
    "$defs": {
      "text": {"type": "string", "not": {"pattern": "^\\s"}}
    }
  },
  "valid": [
    {"name": "form mẫu: $id ở gốc, $ref trong tệp, x-moc-*, pattern an toàn"},
    {"name": "chỉ một trường, không required, không x-moc-range",
     "set": {"/properties": {"hang": {"type": "string"}}}, "unset": ["/required", "/x-moc-range"]},
    {"name": "tên trường dài đúng 64 ký tự",
     "set": {"/properties/tenRatDaiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX": {"type": "string"}}},
    {"name": "x-moc-* chứa khóa trùng tên từ khóa: là câu chữ, không phải schema",
     "set": {"/properties/hang/x-moc-ui/errors": {
       "pattern": {"vi": "Sai mẫu", "en": "Wrong pattern"},
       "patternProperties": {"vi": "Sai khóa", "en": "Wrong key"}}}},
    {"name": "$ref tới $defs thay cho cả trường",
     "set": {"/$defs/hang": {"enum": ["but", "giay"]}, "/properties/hang": {"$ref": "#/$defs/hang"}}},
    {"name": "JSON Pointer có ~0 và %25",
     "set": {"/$defs/a~b%": {"type": "string"}, "/properties/maPhieu": {"$ref": "#/$defs/a~0b%25"}}},
    {"name": "lồng đúng 32 tầng",
     "set": {"/properties/ghiChu/x-moc-ui": {"$nest": "help", "times": 28, "leaf": {"vi": "x"}}}}
  ],
  "invalid": [
    {"name": "tệp lớn quá 256 KB", "set": {"/description": {"$repeat": "a", "times": 270000}}, "errors": ["size"]},
    {"name": "không phải JSON: dấu phẩy thừa", "text": ["{\"type\": \"object\",}"], "errors": ["json"]},
    {"name": "lồng 33 tầng",
     "set": {"/properties/ghiChu/x-moc-ui": {"$nest": "help", "times": 29, "leaf": {"vi": "x"}}},
     "errors": ["depth"]},
    {"name": "đối tượng lồng 3000 tầng (trước đây RecursionError ở _walk)",
     "set": {"/properties/hang/x-moc-ui": {"$nest": "help", "times": 3000, "leaf": {}}}, "errors": ["depth"]},
    {"name": "mảng lồng 100000 tầng (trước đây RecursionError ở json.loads)",
     "text": [{"$repeat": "[", "times": 100000}, {"$repeat": "]", "times": 100000}], "errors": ["depth"]},
    {"name": "gốc là mảng", "set": {"": [1, 2]}, "errors": ["root"]},
    {"name": "gốc là chuỗi", "set": {"": "form"}, "errors": ["root"]},
    {"name": "$schema draft-07", "set": {"/$schema": "http://json-schema.org/draft-07/schema#"}, "errors": ["draft"]},
    {"name": "type ở gốc là array", "set": {"/type": "array"}, "errors": ["root-type"]},
    {"name": "thiếu additionalProperties", "unset": ["/additionalProperties"], "errors": ["additional-properties"]},
    {"name": "additionalProperties: true", "set": {"/additionalProperties": true}, "errors": ["additional-properties"]},
    {"name": "properties rỗng", "set": {"/properties": {}}, "errors": ["properties"]},
    {"name": "properties là mảng, kèm lỗi trước đó",
     "set": {"/properties": []}, "unset": ["/additionalProperties"],
     "errors": ["additional-properties", "properties"]},
    {"name": "trường trùng biến hệ thống", "set": {"/properties/tenantId": {"type": "string"}}, "errors": ["reserved"]},
    {"name": "trường trùng tên Flowable", "set": {"/properties/execution": {"type": "string"}},
     "errors": ["engine-name"]},
    {"name": "tên trường có gạch dưới", "set": {"/properties/ho_ten": {"type": "string"}}, "errors": ["field-name"]},
    {"name": "tên trường viết hoa đầu", "set": {"/properties/HoTen": {"type": "string"}}, "errors": ["field-name"]},
    {"name": "tên trường mở đầu bằng số", "set": {"/properties/1hang": {"type": "string"}}, "errors": ["field-name"]},
    {"name": "tên trường dài 65 ký tự",
     "set": {"/properties/tenRatDaiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX": {"type": "string"}},
     "errors": ["field-name"]},
    {"name": "trường không phải schema", "set": {"/properties/hang": "string"}, "errors": ["field-schema"]},
    {"name": "tên sai và không phải schema", "set": {"/properties/Hang": 5}, "errors": ["field-name", "field-schema"]},
    {"name": "trường kiểu object", "set": {"/properties/hang/type": "object"}, "errors": ["scalar"]},
    {"name": "trường kiểu string hoặc array", "set": {"/properties/hang/type": ["string", "array"]},
     "errors": ["scalar"]},
    {"name": "type là đối tượng (trước đây TypeError)", "set": {"/properties/hang/type": {"kieu": "string"}},
     "errors": ["scalar"]},
    {"name": "type là mảng chứa đối tượng (trước đây TypeError)", "set": {"/properties/hang/type": [{}]},
     "errors": ["scalar"]},
    {"name": "type là null", "set": {"/properties/hang/type": null}, "errors": ["scalar"]},
    {"name": "enum có mảng", "set": {"/properties/hang/enum": ["but", ["giay"]]}, "errors": ["enum"]},
    {"name": "enum có đối tượng", "set": {"/properties/hang/enum": [{"ten": "but"}]}, "errors": ["enum"]},
    {"name": "x-moc-date lạ", "set": {"/properties/tuNgay/x-moc-date": "tomorrow"}, "errors": ["x-moc-date"]},
    {"name": "x-moc-date là mảng (trước đây TypeError)", "set": {"/properties/tuNgay/x-moc-date": []},
     "errors": ["x-moc-date"]},
    {"name": "x-moc-date là null", "set": {"/properties/tuNgay/x-moc-date": null}, "errors": ["x-moc-date"]},
    {"name": "required có trường không khai", "set": {"/required": ["hang", "mauSac"]}, "errors": ["required"]},
    {"name": "required là số (trước đây TypeError)", "set": {"/required": 5}, "errors": ["required"]},
    {"name": "required chứa đối tượng (trước đây TypeError)", "set": {"/required": [{}]}, "errors": ["required"]},
    {"name": "required là null", "set": {"/required": null}, "errors": ["required"]},
    {"name": "required là chuỗi", "set": {"/required": "hang"}, "errors": ["required"]},
    {"name": "x-moc-range thiếu trường sau", "set": {"/x-moc-range": [["tuNgay"]]}, "errors": ["x-moc-range"]},
    {"name": "x-moc-range hai lần cùng trường", "set": {"/x-moc-range": [["tuNgay", "tuNgay"]]},
     "errors": ["x-moc-range"]},
    {"name": "x-moc-range với trường không phải ngày", "set": {"/x-moc-range": [["soLuong", "denNgay"]]},
     "errors": ["x-moc-range"]},
    {"name": "x-moc-range với trường không khai", "set": {"/x-moc-range": [["tuNgay", "khongCo"]]},
     "errors": ["x-moc-range"]},
    {"name": "x-moc-range có tên trường là mảng (trước đây TypeError)",
     "set": {"/x-moc-range": [[["tuNgay"], "denNgay"]]}, "errors": ["x-moc-range"]},
    {"name": "x-moc-range là chuỗi", "set": {"/x-moc-range": "tuNgay"}, "errors": ["x-moc-range"]},
    {"name": "$id dưới gốc", "set": {"/properties/hang/$id": "urn:moc:hang"}, "errors": ["root-only"]},
    {"name": "$anchor trong $defs", "set": {"/$defs/text/$anchor": "text"}, "errors": ["root-only"]},
    {"name": "$ref ra ngoài tệp", "set": {"/properties/hang": {"$ref": "https://example.com/hang.json"}},
     "errors": ["ref-external"]},
    {"name": "$ref tới tệp bên cạnh", "set": {"/properties/hang": {"$ref": "hang.json"}}, "errors": ["ref-external"]},
    {"name": "$dynamicRef", "set": {"/properties/hang": {"$dynamicRef": "#hang"}}, "errors": ["dynamic-ref"]},
    {"name": "$recursiveRef", "set": {"/properties/hang": {"$recursiveRef": "#"}}, "errors": ["dynamic-ref"]},
    {"name": "format email", "set": {"/properties/soLuong": {"type": "string", "format": "email"}},
     "errors": ["format"]},
    {"name": "format date-time", "set": {"/properties/tuNgay/format": "date-time"},
     "errors": ["format", "x-moc-range"]},
    {"name": "patternProperties ở trường", "set": {"/properties/hang/patternProperties": {"^a": {}}},
     "errors": ["pattern-properties"]},
    {"name": "propertyNames ở gốc", "set": {"/propertyNames": {"maxLength": 10}}, "errors": ["pattern-properties"]},
    {"name": "$ref tới đích không có", "set": {"/properties/hang": {"$ref": "#/$defs/khongCo"}},
     "errors": ["ref-target"]},
    {"name": "$ref kiểu tên neo", "set": {"/properties/hang": {"$ref": "#hang"}}, "errors": ["ref-target"]},
    {"name": "$ref tới chỉ số mảng quá dài", "set": {"/properties/hang": {"$ref": "#/required/7"}},
     "errors": ["ref-target"]},
    {"name": "$ref vòng qua hai đích",
     "set": {"/$defs/a": {"$ref": "#/$defs/b"}, "/$defs/b": {"$ref": "#/$defs/a"},
             "/properties/hang": {"$ref": "#/$defs/a"}},
     "errors": ["ref-loop"]},
    {"name": "$ref về chính gốc", "set": {"/properties/hang": {"$ref": "#"}}, "errors": ["ref-loop"]},
    {"name": "$ref lồng 17 tầng",
     "set": {"/$defs/d0": {"$ref": "#/$defs/d1"}, "/$defs/d1": {"$ref": "#/$defs/d2"},
             "/$defs/d2": {"$ref": "#/$defs/d3"}, "/$defs/d3": {"$ref": "#/$defs/d4"},
             "/$defs/d4": {"$ref": "#/$defs/d5"}, "/$defs/d5": {"$ref": "#/$defs/d6"},
             "/$defs/d6": {"$ref": "#/$defs/d7"}, "/$defs/d7": {"$ref": "#/$defs/d8"},
             "/$defs/d8": {"$ref": "#/$defs/d9"}, "/$defs/d9": {"$ref": "#/$defs/d10"},
             "/$defs/d10": {"$ref": "#/$defs/d11"}, "/$defs/d11": {"$ref": "#/$defs/d12"},
             "/$defs/d12": {"$ref": "#/$defs/d13"}, "/$defs/d13": {"$ref": "#/$defs/d14"},
             "/$defs/d14": {"$ref": "#/$defs/d15"}, "/$defs/d15": {"$ref": "#/$defs/d16"},
             "/$defs/d16": {"type": "string"}, "/properties/hang": {"$ref": "#/$defs/d0"}},
     "errors": ["ref-loop"]},
    {"name": "mười $ref mỗi tầng, năm tầng: quá trần số bước",
     "set": {
       "/$defs/l0": {"allOf": [{"$ref": "#/$defs/l1"}, {"$ref": "#/$defs/l1"}, {"$ref": "#/$defs/l1"},
                               {"$ref": "#/$defs/l1"}, {"$ref": "#/$defs/l1"}, {"$ref": "#/$defs/l1"},
                               {"$ref": "#/$defs/l1"}, {"$ref": "#/$defs/l1"}, {"$ref": "#/$defs/l1"},
                               {"$ref": "#/$defs/l1"}]},
       "/$defs/l1": {"allOf": [{"$ref": "#/$defs/l2"}, {"$ref": "#/$defs/l2"}, {"$ref": "#/$defs/l2"},
                               {"$ref": "#/$defs/l2"}, {"$ref": "#/$defs/l2"}, {"$ref": "#/$defs/l2"},
                               {"$ref": "#/$defs/l2"}, {"$ref": "#/$defs/l2"}, {"$ref": "#/$defs/l2"},
                               {"$ref": "#/$defs/l2"}]},
       "/$defs/l2": {"allOf": [{"$ref": "#/$defs/l3"}, {"$ref": "#/$defs/l3"}, {"$ref": "#/$defs/l3"},
                               {"$ref": "#/$defs/l3"}, {"$ref": "#/$defs/l3"}, {"$ref": "#/$defs/l3"},
                               {"$ref": "#/$defs/l3"}, {"$ref": "#/$defs/l3"}, {"$ref": "#/$defs/l3"},
                               {"$ref": "#/$defs/l3"}]},
       "/$defs/l3": {"allOf": [{"$ref": "#/$defs/l4"}, {"$ref": "#/$defs/l4"}, {"$ref": "#/$defs/l4"},
                               {"$ref": "#/$defs/l4"}, {"$ref": "#/$defs/l4"}, {"$ref": "#/$defs/l4"},
                               {"$ref": "#/$defs/l4"}, {"$ref": "#/$defs/l4"}, {"$ref": "#/$defs/l4"},
                               {"$ref": "#/$defs/l4"}]},
       "/$defs/l4": {"type": "string"},
       "/properties/hang": {"$ref": "#/$defs/l0"}},
     "errors": ["steps"]},
    {"name": "nhiều lỗi một lúc",
     "set": {"/properties/ho_ten": {"type": "string", "format": "email"}, "/properties/tenantId": {"type": "object"}},
     "errors": ["field-name", "format", "reserved", "scalar"]},
    {"name": "pattern dễ quay lui bùng nổ (chỉ máy chủ)",
     "set": {"/properties/ghiChu/pattern": "^(a+)+$"}, "errors": ["pattern"]},
    {"name": "pattern không neo, không maxLength (chỉ máy chủ)",
     "set": {"/properties/maPhieu/pattern": "[0-9]+"}, "errors": ["pattern"]},
    {"name": "minimum không phải số: sai meta-schema (chỉ máy chủ)",
     "set": {"/properties/soLuong/minimum": "một"}, "errors": ["schema"]}
  ]
}
