# Công bố mốc neo sổ kiểm toán ra một kho git công khai (scripts/moc.py audit anchor --publish): neo đầu chuỗi, ghi mốc
# kèm chữ ký của két vào anchors.jsonl, commit, push — không bao giờ ép. Tệp MẪU: sửa đường dẫn, người dùng cho đúng
# máy chủ rồi cài (docs/van-hanh.md mục "Mốc neo công khai" — trước đó phải có bản sao git của kho công khai và khóa
# triển khai chỉ ghi được vào kho đó):
#
#   sudo cp platform/systemd/moc-anchor-publish.service platform/systemd/moc-anchor-publish.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now moc-anchor-publish.timer
#   journalctl -u moc-anchor-publish -f        # xem từng lượt
#
# Chạy trên máy chủ, không trong container: lệnh gọi svc-files qua docker compose như `make audit`.

[Unit]
Description=Signet — công bố mốc neo sổ kiểm toán ra kho git công khai (một lượt)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# Người vận hành sở hữu thư mục cài (make install) và bản sao kho mốc, thuộc nhóm docker; không chạy bằng root.
# Khóa triển khai của kho mốc nằm trong ~/.ssh của người dùng này (Host trong ~/.ssh/config)
User=moc
Group=docker
WorkingDirectory=/opt/moc
ExecStart=/usr/bin/python3 /opt/moc/scripts/moc.py audit anchor --publish /var/lib/moc/neo-cong-khai
# Một lượt chỉ vài giây; mạng treo lúc push thì không giữ mãi — lượt sau đẩy tiếp commit còn lại
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
