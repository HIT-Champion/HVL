{
  "realm": "moc",
  "displayName": "Signet",
  "loginTheme": "signet",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "organizationsEnabled": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(10) and notUsername",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "browserFlow": "moc-browser",
  "directGrantFlow": "moc-cli-direct-grant",
  "authenticationFlows": [
    {
      "alias": "moc-browser",
      "description": "Đăng nhập trên trình duyệt: mật khẩu, rồi mã TOTP — bắt buộc với văn thư, lãnh đạo, quản trị đơn vị; với vai trò khác chỉ hỏi khi người đó đã tự cài TOTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false},
        {"flowAlias": "moc-browser-forms", "requirement": "ALTERNATIVE", "priority": 20, "autheticatorFlow": true, "userSetupAllowed": false}
      ]
    },
    {
      "alias": "moc-browser-forms",
      "description": "Mật khẩu, rồi TOTP theo vai trò",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false},
        {"flowAlias": "moc-otp-bat-buoc", "requirement": "CONDITIONAL", "priority": 20, "autheticatorFlow": true, "userSetupAllowed": false},
        {"flowAlias": "moc-otp-tu-chon", "requirement": "CONDITIONAL", "priority": 30, "autheticatorFlow": true, "userSetupAllowed": false}
      ]
    },
    {
      "alias": "moc-otp-bat-buoc",
      "description": "Văn thư, lãnh đạo phòng, lãnh đạo đơn vị, quản trị đơn vị: bắt buộc TOTP; chưa cài thì Keycloak bắt cài ngay ở lần đăng nhập này",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "conditional-user-attribute", "authenticatorConfig": "moc-vai-tro-bat-buoc-otp", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false},
        {"authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "userSetupAllowed": false}
      ]
    },
    {
      "alias": "moc-otp-tu-chon",
      "description": "Vai trò khác đã tự cài TOTP: hỏi mã",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "conditional-user-configured", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false},
        {"authenticator": "conditional-user-attribute", "authenticatorConfig": "moc-vai-tro-khong-bat-buoc-otp", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "userSetupAllowed": false},
        {"authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 30, "autheticatorFlow": false, "userSetupAllowed": false}
      ]
    },
    {
      "id": "caf1a197-9781-4731-b8a2-5a9ae6ebe31d",
      "alias": "moc-cli-direct-grant",
      "description": "Client moc-cli (make seed, make smoke, CI): mật khẩu rồi mã TOTP (tham số otp) theo đúng quy tắc của trình duyệt — không là đường vòng qua xác thực hai bước",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "direct-grant-validate-username", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false},
        {"authenticator": "direct-grant-validate-password", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "userSetupAllowed": false},
        {"flowAlias": "moc-cli-otp-bat-buoc", "requirement": "CONDITIONAL", "priority": 30, "autheticatorFlow": true, "userSetupAllowed": false},
        {"flowAlias": "moc-cli-otp-tu-chon", "requirement": "CONDITIONAL", "priority": 40, "autheticatorFlow": true, "userSetupAllowed": false}
      ]
    },
    {
      "alias": "moc-cli-otp-bat-buoc",
      "description": "Văn thư, lãnh đạo phòng, lãnh đạo đơn vị, quản trị đơn vị: bắt buộc mã TOTP; chưa cài TOTP thì không lấy được token (luồng này không cài được)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "conditional-user-attribute", "authenticatorConfig": "moc-vai-tro-bat-buoc-otp", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false},
        {"authenticator": "direct-grant-validate-otp", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "userSetupAllowed": false}
      ]
    },
    {
      "alias": "moc-cli-otp-tu-chon",
      "description": "Vai trò khác đã tự cài TOTP: hỏi mã",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "conditional-user-configured", "requirement": "REQUIRED", "priority": 10, "autheticatorFlow": false, "userSetupAllowed": false},
        {"authenticator": "conditional-user-attribute", "authenticatorConfig": "moc-vai-tro-khong-bat-buoc-otp", "requirement": "REQUIRED", "priority": 20, "autheticatorFlow": false, "userSetupAllowed": false},
        {"authenticator": "direct-grant-validate-otp", "requirement": "REQUIRED", "priority": 30, "autheticatorFlow": false, "userSetupAllowed": false}
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "moc-vai-tro-bat-buoc-otp",
      "config": {"attribute_name": "moc_role", "attribute_expected_value": "^(clerk|manager|director|tenant_admin)$", "regex": "true", "not": "false", "include_group_attributes": "false"}
    },
    {
      "alias": "moc-vai-tro-khong-bat-buoc-otp",
      "config": {"attribute_name": "moc_role", "attribute_expected_value": "^(clerk|manager|director|tenant_admin)$", "regex": "true", "not": "true", "include_group_attributes": "false"}
