# =============================================================================
# Mộc — Git Ignore
# Tuân thủ tiêu chí đánh giá PoF (Tiêu chí #4, #5)
# =============================================================================

# --- Môi trường & Bí mật (Secrets) -------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Dữ liệu runtime & CSDL (không commit — do container sinh ra) ------------
# Neo ở gốc repo: thư mục mã nguồn trùng tên (vd. seed/data/) vẫn được theo dõi.
/data/
/volumes/
/storage/
/backups/
# scripts/backup.py đặt trong lúc khôi phục (F3.3: reconciler không dựng lại Mộc trên dữ liệu dở dang)
/.moc-restoring
*.db
*.sqlite
*.sqlite3
*.dump
*.rdb
# Không bỏ qua *.sql: migration trong db/migrations/ là mã nguồn. Bản sao lưu
# nằm trong /backups/ hoặc ở dạng nén (*.gz, đã bỏ qua ở dưới).

# --- Bản dựng & Gói nén phát hành (Build & Archives) -------------------------
dist/
build/
out/
bin/
*.tar.gz
*.zip
*.rar
*.7z
*.tar
*.gz
*.sha256

# --- Phụ thuộc (KHÔNG bundle mã nguồn dự án khác — tiêu chí PoF #5) ----------
node_modules/
vendor/
third_party/
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Tài liệu nhị phân & Thể lệ cuộc thi ------------------------------------
public/*.pdf
*.pdf
# Văn bản đến mẫu (giả lập) để thử, đo tác tử đọc văn bản F4.1 — sinh bằng make van-ban-mau
!/seed/van-ban-den/*.pdf

# --- Docker overrides cục bộ -------------------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml

# --- Nhật ký & Tệp tạm -------------------------------------------------------
*.log
logs/
tmp/
temp/
.cache/
*.pid
*.seed
*.pid.lock

# --- IDE & Hệ điều hành (OS) -------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*~
*.swp
*.swo


# Bản lưu cục bộ của tài liệu BTC (không phân phối lại)
publics/

# Tài liệu nội bộ của đội — không đưa lên repo công khai (ví dụ TEAM.local.md)
*.local.md
/COMMIT.md
