# Phục vụ giao diện tĩnh sau APISIX. ${MOC_REALM} do image nginx thay từ biến môi trường lúc khởi động.

# F4.4: nhật ký truy cập không ghi chuỗi truy vấn (trang Tìm kiếm, Hỏi đáp đặt câu tìm vào ?q=…) và Referer. Tệp này
# được include trong khối http nên khai map, log_format ở đây được. Đường dẫn lấy từ $request_uri (đúng như client
# gửi), giữ phần trước dấu ? đầu tiên; không dùng $uri vì try_files đổi nó thành /index.html. Các trường khác giữ như
# định dạng main của image. envsubst chỉ thay biến môi trường đã khai, nên biến nginx ở đây giữ nguyên.
map $request_uri $moc_duong_dan {
    "~^(?<moc_dd>[^?]*)" $moc_dd;
}
log_format moc_khong_truy_van '$remote_addr - $remote_user [$time_local] '
                              '"$request_method $moc_duong_dan $server_protocol" '
                              '$status $body_bytes_sent "$http_user_agent" "$http_x_forwarded_for"';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    access_log /var/log/nginx/access.log moc_khong_truy_van;

    # nginx chỉ kế thừa add_header khi khối con không có add_header nào, nên mỗi location tự include
    # security-headers.conf. $csp_scripts: băm của các đoạn script nội tuyến, tính lúc dựng image (scripts/csp-hashes.mjs)
    include /etc/nginx/csp.conf;

    # Cấu hình đọc lúc chạy: đổi realm không phải dựng lại giao diện (PoF #4)
    location = /config.json {
        default_type application/json;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 200 '{"realm":"${MOC_REALM}","clientId":"app-office"}';
    }

    # Tệp đã băm tên: lưu đệm lâu
    location /_nuxt/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Ứng dụng một trang: mọi đường dẫn khác trả về index.html
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        # $uri/index.html thay cho $uri/: không để nginx chuyển hướng thêm dấu / (làm mất trang nhận đăng nhập)
        try_files $uri $uri/index.html /index.html;
    }
}
