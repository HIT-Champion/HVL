<!--
  Đổi, bù lịch giảng — quy trình của ứng dụng ngành apps/lich-giang (Tầng 3), khai ở mục workflow của app.yaml. moc app
  install triển khai tệp này lên động cơ quy trình của lõi (Flowable sau svc-workflow); trang gọi API chung
  /api/workflow/lich-giang/… bằng token của client app-lich-giang. Như Đơn nghỉ phép (apps/nghi-phep), ứng dụng không
  có mã chạy trên máy chủ: chỉ sự kiện bắt đầu, kết thúc, việc người làm và cổng rẽ nhánh so dữ liệu form với hằng số.
  Hai cấp duyệt:
    boMon   trưởng bộ môn của chính bộ môn người gửi: nhóm t:<tenantId>:d:<departmentId>:manager, như bước duyệt cấp
            phòng của văn bản đi (services/svc-workflow/processes/van-ban-di.bpmn20.xml)
    khoa    lãnh đạo khoa: nhóm t:<tenantId>:director, như bước chỉ đạo của văn bản đến (van-ban-den.bpmn20.xml)
  Bộ môn không đồng ý thì dừng, không tới khoa.
  Biến:
    tenantId, departmentId   đơn vị, bộ môn của người gửi — lõi đặt từ token lúc khởi chạy
    initiator                người gửi (sub)
    loai, hocPhan, lopHocPhan, ngayCu, tietCu, ngayMoi, tietMoi, phongMoi, lyDo   form lich-giang.don (forms/don.json)
    quyetDinhBoMon, ghiChuBoMon   form lich-giang.bo-mon (forms/bo-mon.json): dong-y | tu-choi
    quyetDinhKhoa, ghiChuKhoa     form lich-giang.khoa (forms/khoa.json): dong-y | tu-choi
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="https://moc.example/bpmn/lich-giang">
  <process id="lich-giang.don" name="Đổi, bù lịch giảng" isExecutable="true">
    <startEvent id="guiDon" name="Giảng viên gửi đề nghị" flowable:formKey="lich-giang.don"
                flowable:initiator="initiator"/>
    <sequenceFlow id="f1" sourceRef="guiDon" targetRef="boMon"/>
    <userTask id="boMon" name="Trưởng bộ môn duyệt" flowable:formKey="lich-giang.bo-mon"
              flowable:candidateGroups="t:${tenantId}:d:${departmentId}:manager"/>
    <sequenceFlow id="f2" sourceRef="boMon" targetRef="ketQuaBoMon"/>
    <exclusiveGateway id="ketQuaBoMon" name="Bộ môn đồng ý?"/>
    <sequenceFlow id="f3" name="Đồng ý" sourceRef="ketQuaBoMon" targetRef="khoa">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${quyetDinhBoMon == 'dong-y'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f4" name="Không đồng ý" sourceRef="ketQuaBoMon" targetRef="boMonTuChoi">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${quyetDinhBoMon == 'tu-choi'}]]></conditionExpression>
    </sequenceFlow>
    <userTask id="khoa" name="Lãnh đạo khoa phê duyệt" flowable:formKey="lich-giang.khoa"
              flowable:candidateGroups="t:${tenantId}:director"/>
    <sequenceFlow id="f5" sourceRef="khoa" targetRef="ketQuaKhoa"/>
    <exclusiveGateway id="ketQuaKhoa" name="Khoa phê duyệt?"/>
    <sequenceFlow id="f6" name="Đồng ý" sourceRef="ketQuaKhoa" targetRef="daDuyet">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${quyetDinhKhoa == 'dong-y'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f7" name="Không đồng ý" sourceRef="ketQuaKhoa" targetRef="khoaTuChoi">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${quyetDinhKhoa == 'tu-choi'}]]></conditionExpression>
    </sequenceFlow>
    <endEvent id="daDuyet" name="Đã duyệt"/>
    <endEvent id="boMonTuChoi" name="Bộ môn không đồng ý"/>
    <endEvent id="khoaTuChoi" name="Khoa không duyệt"/>
  </process>
  <!-- Sơ đồ để mở bằng trình vẽ BPMN; động cơ quy trình không đọc phần này -->
  <bpmndi:BPMNDiagram id="soDo">
    <bpmndi:BPMNPlane id="soDoQuyTrinh" bpmnElement="lich-giang.don">
      <bpmndi:BPMNShape id="guiDon_hinh" bpmnElement="guiDon">
        <omgdc:Bounds x="40" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boMon_hinh" bpmnElement="boMon">
        <omgdc:Bounds x="130" y="80" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ketQuaBoMon_hinh" bpmnElement="ketQuaBoMon" isMarkerVisible="true">
        <omgdc:Bounds x="320" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="khoa_hinh" bpmnElement="khoa">
        <omgdc:Bounds x="430" y="80" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ketQuaKhoa_hinh" bpmnElement="ketQuaKhoa" isMarkerVisible="true">
        <omgdc:Bounds x="620" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="daDuyet_hinh" bpmnElement="daDuyet">
        <omgdc:Bounds x="740" y="32" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="khoaTuChoi_hinh" bpmnElement="khoaTuChoi">
        <omgdc:Bounds x="740" y="172" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boMonTuChoi_hinh" bpmnElement="boMonTuChoi">
        <omgdc:Bounds x="327" y="232" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_duong" bpmnElement="f1">
        <omgdi:waypoint x="76" y="120"/>
        <omgdi:waypoint x="130" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_duong" bpmnElement="f2">
        <omgdi:waypoint x="260" y="120"/>
        <omgdi:waypoint x="320" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_duong" bpmnElement="f3">
        <omgdi:waypoint x="370" y="120"/>
        <omgdi:waypoint x="430" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_duong" bpmnElement="f4">
        <omgdi:waypoint x="345" y="145"/>
        <omgdi:waypoint x="345" y="232"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_duong" bpmnElement="f5">
        <omgdi:waypoint x="560" y="120"/>
        <omgdi:waypoint x="620" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_duong" bpmnElement="f6">
        <omgdi:waypoint x="645" y="95"/>
        <omgdi:waypoint x="645" y="50"/>
        <omgdi:waypoint x="740" y="50"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_duong" bpmnElement="f7">
        <omgdi:waypoint x="645" y="145"/>
        <omgdi:waypoint x="645" y="190"/>
        <omgdi:waypoint x="740" y="190"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
