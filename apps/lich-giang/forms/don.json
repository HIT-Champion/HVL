{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moc:app:lich-giang:form:don",
  "title": "Đề nghị đổi, bù lịch giảng",
  "description": "Form gửi đề nghị đổi, bù lịch giảng (formKey lich-giang.don). Ca thử dùng chung: don.cases.json.",
  "x-moc-title": {"vi": "Đề nghị đổi, bù lịch giảng", "en": "Teaching schedule change request"},
  "x-moc-order": ["loai", "hocPhan", "lopHocPhan", "ngayCu", "tietCu", "ngayMoi", "tietMoi", "phongMoi", "lyDo"],
  "x-moc-nfc": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["loai", "hocPhan", "lopHocPhan", "ngayCu", "tietCu", "ngayMoi", "tietMoi", "phongMoi", "lyDo"],
  "properties": {
    "loai": {
      "title": "Loại đề nghị",
      "enum": ["doi-lich", "day-bu"],
      "x-moc-ui": {
        "label": {"vi": "Loại đề nghị", "en": "Request type"},
        "options": {
          "doi-lich": {"vi": "Đổi lịch (dời buổi dạy sang ngày khác)", "en": "Reschedule a class"},
          "day-bu": {"vi": "Dạy bù (bù buổi đã nghỉ)", "en": "Make up a missed class"}
        }
      }
    },
    "hocPhan": {
      "title": "Học phần",
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "$ref": "#/$defs/text",
      "x-moc-ui": {"label": {"vi": "Học phần", "en": "Course"}}
    },
    "lopHocPhan": {
      "title": "Lớp học phần",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "$ref": "#/$defs/text",
      "x-moc-ui": {
        "label": {"vi": "Lớp học phần", "en": "Class section"},
        "help": {"vi": "Mã lớp như trên thời khóa biểu.", "en": "The section code as on the timetable."}
      }
    },
    "ngayCu": {
      "title": "Ngày dạy theo lịch",
      "type": "string",
      "format": "date",
      "pattern": "^20[0-9]{2}-",
      "x-moc-ui": {
        "label": {"vi": "Ngày dạy theo lịch", "en": "Scheduled date"},
        "help": {
          "vi": "Dạy bù thì chọn ngày của buổi đã nghỉ.",
          "en": "For a make-up class, the date of the missed class."
        },
        "errors": {"pattern": {"vi": "Năm phải từ 2000 đến 2099", "en": "The year must be between 2000 and 2099"}}
      }
    },
    "tietCu": {
      "title": "Tiết theo lịch",
      "type": "string",
      "pattern": "^[0-9]{1,2}(-[0-9]{1,2})?$",
      "x-moc-ui": {
        "label": {"vi": "Tiết theo lịch", "en": "Scheduled periods"},
        "help": {"vi": "Ví dụ 1-3 là tiết 1 đến tiết 3.", "en": "For example 1-3 means periods 1 to 3."},
        "errors": {"pattern": {"vi": "Ghi số tiết, ví dụ 4 hoặc 1-3", "en": "Write the periods, for example 4 or 1-3"}}
      }
    },
    "ngayMoi": {
      "title": "Ngày dạy mới",
      "type": "string",
      "format": "date",
      "pattern": "^20[0-9]{2}-",
      "x-moc-date": "not-before-today",
      "x-moc-ui": {
        "label": {"vi": "Ngày dạy mới", "en": "New date"},
        "errors": {"pattern": {"vi": "Năm phải từ 2000 đến 2099", "en": "The year must be between 2000 and 2099"}}
      }
    },
    "tietMoi": {
      "title": "Tiết dạy mới",
      "type": "string",
      "pattern": "^[0-9]{1,2}(-[0-9]{1,2})?$",
      "x-moc-ui": {
        "label": {"vi": "Tiết dạy mới", "en": "New periods"},
        "errors": {"pattern": {"vi": "Ghi số tiết, ví dụ 4 hoặc 1-3", "en": "Write the periods, for example 4 or 1-3"}}
      }
    },
    "phongMoi": {
      "title": "Phòng học",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "$ref": "#/$defs/text",
      "x-moc-ui": {
        "label": {"vi": "Phòng học", "en": "Room"},
        "help": {"vi": "Phòng của buổi dạy mới, ví dụ A1-301.", "en": "Room for the new class, for example A1-301."}
      }
    },
    "lyDo": {
      "title": "Lý do",
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "$ref": "#/$defs/text",
      "x-moc-ui": {"widget": "textarea", "rows": 3, "label": {"vi": "Lý do", "en": "Reason"}}
    }
  },
  "$defs": {
    "text": {
      "$comment": "Như $defs.text của schemas/van-ban-den.json: xuống dòng được, không ký tự ẩn, không trắng hai đầu.",
      "type": "string",
      "allOf": [
        {"not": {"pattern": "[\u0000-\t\u000b\f\u000e-\u001f\u007f-\u009f\u00ad\u115f\u1160\u200b-\u200f]"}},
        {"not": {"pattern": "[\u202a-\u202e\u2060-\u2064\u2066-\u2069\u3164\ufeff\uffa0\u2028\u2029]"}},
        {"not": {"pattern": "^[\t\n\u000b\f\r \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]"}},
        {"not": {"pattern": "[\t\n\u000b\f\r \u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]$"}}
      ]
    }
  }
}
