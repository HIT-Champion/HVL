# Phục vụ Không gian cá nhân ở /ca-nhan/ sau APISIX (route app-ca-nhan). ${MOC_REALM} do image nginx thay từ biến môi
# trường lúc khởi động; envsubst chỉ thay biến môi trường đã khai nên biến nginx ở đây giữ nguyên.

# Nhật ký truy cập không ghi chuỗi truy vấn và Referer, như app-office (F4.4): bước đăng nhập mang ?code=…&state=…
map $request_uri $moc_duong_dan {
    "~^(?<moc_dd>[^?]*)" $moc_dd;
}
log_format moc_khong_truy_van '$remote_addr - $remote_user [$time_local] '
                              '"$request_method $moc_duong_dan $server_protocol" '
                              '$status $body_bytes_sent "$http_user_agent" "$http_x_forwarded_for"';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    # chuyển hướng tương đối: nginx sau APISIX không biết cổng, tên miền công khai
    absolute_redirect off;
    access_log /var/log/nginx/access.log moc_khong_truy_van;

    # nginx chỉ kế thừa add_header khi khối con không có add_header nào, nên mỗi location tự include
    # security-headers.conf

    location = /ca-nhan {
        include /etc/nginx/security-headers.conf;
        return 302 /ca-nhan/;
    }

    # Cấu hình đọc lúc chạy: đổi realm không phải dựng lại giao diện
    location = /ca-nhan/config.json {
        default_type application/json;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 200 '{"realm":"${MOC_REALM}","clientId":"app-ca-nhan"}';
    }

    # Tệp không băm tên (không có bước đóng gói): trình duyệt hỏi lại mỗi lần, nginx trả 304 khi chưa đổi.
    # Đường dẫn khác (vd /ca-nhan/dang-nhap, nơi Keycloak trả về sau đăng nhập) là trang của ứng dụng: index.html
    location /ca-nhan/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /ca-nhan/index.html;
    }

    location / {
        include /etc/nginx/security-headers.conf;
        return 404;
    }
}
