# =============================================================================
# Signet — mẫu cấu hình môi trường
# Sao chép thành .env rồi đổi MỌI giá trị change_me:  cp .env.example .env
# (hoặc `make env` để sinh .env với mật khẩu ngẫu nhiên)
#
# LƯU Ý (tiêu chí PoF #4): mọi tham số cấu hình của Signet đều nằm trong tệp này.
# Không bao giờ sửa trực tiếp vào mã nguồn hay tệp header để cấu hình hệ thống.
# =============================================================================

# --- Chung -------------------------------------------------------------------
MOC_ENV=development
MOC_TIMEZONE=Asia/Ho_Chi_Minh
# Địa chỉ người dùng mở trên trình duyệt — mọi yêu cầu đi qua APISIX ở đây.
# Đổi cổng thì đổi cả hai dòng. Lên máy chủ sau proxy TLS (docs/trien-khai.md): MOC_PUBLIC_URL=https://ten-mien-cua-ban,
# MOC_HTTP_PORT=127.0.0.1:8080 (APISIX chỉ nghe trên máy chủ, proxy chuyển vào; Docker mở cổng không qua tường lửa)
MOC_PUBLIC_URL=http://localhost:8080
MOC_HTTP_PORT=8080
# Dải địa chỉ của proxy TLS mà APISIX tin X-Forwarded-Proto/Host/Port (https, tên miền) và X-Forwarded-For (IP người
# dùng cho giới hạn tốc độ). Proxy trên máy chủ tới APISIX qua cổng 127.0.0.1 mà Docker chuyển vào từ gateway của mạng
# Docker: đặt 172.16.0.0/12 (docs/trien-khai.md); Cloudflare Tunnel (profile tunnel) tới APISIX qua mạng Docker:
# cũng 172.16.0.0/12. Không có proxy (máy dev): để nguyên — không tin ai
MOC_TRUSTED_PROXY=127.0.0.1/32
# Profile chạy thêm cùng core, app — cách nhau bằng dấu phẩy, vd tunnel,logs. make up/down/ps/logs kèm các profile này;
# make install ghi COMPOSE_PROFILES=core,app,<các profile này> vào .env của bản cài cho docker compose up
MOC_EXTRA_PROFILES=
# Profile tunnel (F1.9, docs/trien-khai.md mục 5b): tệp token Cloudflare Tunnel ngoài repo, một dòng TUNNEL_TOKEN=…
MOC_TUNNEL_TOKEN_FILE=/home/moc/cloudflared-tunnel
# Realm Keycloak; đổi thì đổi cả "realm" trong platform/keycloak/realm/moc-realm.json
MOC_REALM=moc
# Giới hạn tốc độ ở APISIX, số yêu cầu mỗi phút (platform/apisix/apisix.yaml). Đăng nhập tính theo địa chỉ IP —
# văn phòng đông người dùng chung một IP thì nâng lên; GraphQL và tệp tính theo phiên đăng nhập; cổng xác
# thực văn bản (không cần đăng nhập) tính theo địa chỉ IP; mở kết nối thông báo realtime tính theo địa chỉ IP
# (mỗi tab mở một kết nối lúc tải trang, mất mạng thì tự nối lại); trạng thái hệ thống (trang /trang-thai, không cần
# đăng nhập, tự làm mới mỗi 30 giây — 2 lần mỗi phút một tab) tính theo địa chỉ IP.
MOC_RATE_LOGIN_PER_MIN=60
MOC_RATE_API_PER_MIN=300
MOC_RATE_VERIFY_PER_MIN=30
MOC_RATE_REALTIME_PER_MIN=60
MOC_RATE_STATUS_PER_MIN=30

# F3.15 — tường lửa ứng dụng web (Coraza + OWASP CRS) ở APISIX: On chặn tải tấn công (403), DetectionOnly chỉ ghi
# nhật ký (dò chặn nhầm trước khi bật), Off tắt luật (platform/apisix/README.md, mục WAF); giá trị khác thì `make up`
# báo lỗi. Mỗi worker APISIX nạp một bộ luật (~80 MB): 4 worker đủ cho một đơn vị; tăng thì tăng RAM tương ứng
MOC_WAF=On
MOC_APISIX_WORKERS=4

# --- Giám sát (F3.13) — Prometheus thu chỉ số của cổng API, Grafana hiện bảng điều khiển ---------
# Grafana chỉ mở trên máy chủ, chỉ xem (không tài khoản): http://127.0.0.1:3300 — xem từ xa thì qua đường hầm SSH
MOC_GRAFANA_PORT=3300
# Prometheus giữ chỉ số bao lâu
MOC_METRICS_RETENTION=15d

# --- Log tập trung (F3.14) — Vector thu log, Parseable lưu và tra; profile logs, tắt mặc định --------------
# Bật lâu dài: thêm logs vào MOC_EXTRA_PROFILES rồi make up (hoặc make logs-up): cả hai thêm mật khẩu vào .env cũ
# nếu thiếu, tạo luồng, đặt giữ log. Bật tạm: chỉ make logs-up (tới lần make up sau). Tra theo mã yêu cầu:
# make logs-tra ID=… (docs/van-hanh.md mục Log tập trung)
# Mật khẩu tài khoản moc của Parseable (Vector cũng dùng): make env sinh, .env cũ thiếu dòng này thì make up (logs
# trong MOC_EXTRA_PROFILES), make logs-up tự thêm; rỗng thì Parseable không khởi động
MOC_LOGS_PASSWORD=change_me
# Giao diện, API của Parseable chỉ mở trên máy chủ: http://127.0.0.1:8400 — xem từ xa thì qua đường hầm SSH
MOC_LOGS_PORT=8400
# Cổng dockerd gửi log vào Vector (driver fluentd), chỉ 127.0.0.1, không xác thực
MOC_LOGS_FLUENT_PORT=24224
# Giữ log bao nhiêu ngày (Parseable xóa mỗi ngày lúc 00:00 UTC); đổi thì chạy lại python3 scripts/log_tap_trung.py init
MOC_LOGS_RETENTION_DAYS=7

# --- IT/OT (F3.10) — context broker NGSI-LD Scorpio, profile iot (make demo-it-ot tự bật) ----------
# Mật khẩu CSDL riêng của broker (chỉ broker nối được, mạng nội bộ riêng)
MOC_NGSI_DB_PASSWORD=change_me
# Nhiệt độ (°C) vượt mức này thì dựng dự thảo "Báo cáo sự cố" cho chuyên viên phụ trách cảm biến
MOC_OT_THRESHOLD=35
# Sơ đồ cảm biến (trang /cam-bien): quá chừng ấy phút (1–1440) không có số đo mới thì cảm biến mang cờ "mất tín hiệu".
# Đặt từ 2–3 lần chu kỳ gửi của thiết bị thật
MOC_OT_STALE_MIN=10

# --- Đọc văn bản đến (F4.1) — tác tử moc-doc-reader trong svc-files ---------------------------------
# Văn thư tải công văn PDF hoặc ảnh chụp ở màn Tiếp nhận: svc-files đọc lớp chữ PDF, không có thì nhận dạng chữ (OCR,
# Tesseract), gợi ý số ký hiệu, ngày ban hành, cơ quan ban hành, loại, độ khẩn, trích yếu; văn thư đối chiếu rồi mới
# lưu. Văn bản hạn chế không bao giờ được đọc. false: tắt (tiếp nhận nhập tay như trước)
MOC_READ_ENABLED=true
# Số lượt đọc cùng lúc — mỗi lượt OCR dùng trọn một lõi CPU; chờ lượt quá 15 giây thì báo bận, văn thư bấm lại
MOC_READ_CONCURRENCY=1
# Hạn nhận dạng chữ (giây). Máy chậm thì nâng, nhưng cả lượt đọc vẫn dừng ở 50 giây (dưới hạn 60 giây của APISIX)
MOC_OCR_TIMEOUT_S=40
# Bản scan (PDF không có lớp chữ) gắn vào văn bản: vòng nền nhận dạng chữ từng này trang đầu để tìm được theo nội dung
# và để trợ lý hỏi đáp trích được. Lần lượt từng tệp, cả tệp tối đa (số trang này × MOC_OCR_TIMEOUT_S) giây. 0: tắt
# (bản scan chỉ tìm được theo số ký hiệu, trích yếu, cơ quan ban hành)
MOC_TEXT_OCR_PAGES=3
# Mô hình ngôn ngữ (tùy chọn, profile ai): chỉ viết trích yếu khi quy tắc không ra trích yếu tin cậy; số, ngày, cơ quan
# luôn theo quy tắc. Bật: make ai-model (tải trọng số một lần, khoảng 2 GB gồm cả mô hình nhúng của trợ lý hỏi đáp,
# cần Internet) rồi make up-ai; chưa bật thì svc-files tự bỏ qua. Để trống MOC_AI_URL thì tắt hẳn, không dò mô hình
MOC_AI_URL=http://ollama:11434
# Tên mô hình trong thư viện Ollama. Máy đủ nhanh thì thử qwen3:4b (đổi rồi chạy lại make ai-model)
MOC_AI_MODEL=qwen3:1.7b
# Hạn chờ mô hình (giây); quá thì trích yếu theo quy tắc
MOC_AI_TIMEOUT_S=20
# fallback: chỉ hỏi mô hình khi quy tắc không ra trích yếu tin cậy cao; always: luôn hỏi
MOC_AI_SUMMARY=fallback
# Bộ nhớ, số lõi tối đa của Ollama. MOC_AI_CPUS không được vượt số lõi của máy (Docker từ chối khởi động). Ollama giữ
# cùng lúc mô hình viết và mô hình nhúng của trợ lý hỏi đáp (mục dưới): khoảng 2 GB với mặc định
MOC_AI_MEM_LIMIT=6g
MOC_AI_CPUS=4

# --- Trợ lý hỏi đáp trên kho văn bản (F4.2) — tác tử moc-assistant trong svc-files ------------------
# Trang "Hỏi đáp": người dùng hỏi bằng câu tự nhiên, trợ lý chỉ tìm trong các văn bản người hỏi được xem (văn bản hạn
# chế không bao giờ được đưa vào) và trả câu trích nguyên văn kèm số ký hiệu, trang. Không cần mô hình: tìm theo từ
# khóa. Bật profile ai (make ai-model rồi make up-ai) thì thêm tìm theo nghĩa và câu trả lời do mô hình viết, mỗi ý có
# trích dẫn. Câu hỏi, câu trả lời không được lưu; sổ kiểm toán chỉ ghi số đoạn, số nguồn, thời gian. false: tắt
MOC_ASK_ENABLED=true
# Mô hình nhúng trong thư viện Ollama (khoảng 640 MB, make ai-model tải cùng MOC_AI_MODEL). Thay được bằng bge-m3
# (khoảng 1,2 GB): đổi rồi chạy lại make ai-model, svc-files tự nhúng lại cả kho. Để trống: chỉ tìm theo từ khóa
MOC_AI_EMBED_MODEL=qwen3-embedding:0.6b
# Mô hình viết câu trả lời; để trống thì dùng MOC_AI_MODEL. Máy đủ nhanh thì thử qwen3:4b (rồi chạy lại make ai-model).
# Khác MOC_AI_MODEL là ba mô hình tranh hai chỗ trong Ollama, nạp đi nạp lại nên dễ quá giờ: đổi luôn MOC_AI_MODEL
MOC_ASK_MODEL=
# Hạn chờ mô hình viết câu trả lời (giây); quá thì vẫn trả câu trích nguyên văn
MOC_ASK_MODEL_TIMEOUT_S=40
# Hạn tổng một câu hỏi (giây), tối đa 55 — dưới hạn 60 giây của APISIX
MOC_ASK_DEADLINE_S=50

# --- Gợi ý giao việc (F4.3) — tác tử moc-assigner trong svc-workflow ---------------------------------
# Văn bản đến vừa vào sổ: song song với bước chỉ đạo, tác tử tìm các văn bản đến tương tự đã giao (theo trích yếu, trong
# chỉ mục của trợ lý hỏi đáp), mỗi văn bản bỏ một phiếu cho đơn vị chủ trì đã giao, rồi gợi ý đơn vị, hạn và căn cứ ở
# đầu form chỉ đạo. "Dùng gợi ý" chỉ điền form, lãnh đạo vẫn là người quyết định. Không cần mô hình. Văn bản hạn chế
# không bao giờ có gợi ý, không làm căn cứ. Tắt trợ lý hỏi đáp (MOC_ASK_ENABLED=false) thì cũng không có gợi ý.
# false: tắt (không tìm, không ghi gì; văn bản vẫn tới lãnh đạo như trước)
MOC_SUGGEST_ENABLED=true
# Bao lâu svc-workflow hỏi Flowable việc gợi ý mới (giây). 0: không chạy — nhánh gợi ý tự bỏ sau 10 phút
MOC_SUGGEST_POLL_INTERVAL_S=2
# Hạn chờ svc-files tìm văn bản tương tự (giây), tối đa 40 — cả lượt gợi ý phải xong trong 60 giây Flowable giữ việc.
# Quá hạn thì gợi ý ghi "không gợi ý được", lãnh đạo giao như thường lệ
MOC_SUGGEST_TIMEOUT_S=10
# Điểm tương tự tối thiểu (0–1) để một văn bản được làm căn cứ. Nâng lên thì ít gợi ý hơn nhưng chắc hơn
MOC_SUGGEST_MIN_SCORE=0.3
# Danh tính của tác tử trong sổ kiểm toán và trong bảng gợi ý
MOC_ASSIGNER_ID=moc-assigner

# --- Ký số văn bản đi (F4.5) — chỉ minh họa ------------------------------------------------------------
# Bản phát hành văn bản đi (không hạn chế) được svc-files ký số PAdES bằng khóa riêng của đơn vị nằm trong két OpenBao
# (Transit, khóa không rời két); chứng thư do CA nội bộ trong két cấp. Chỉ minh họa: CA tự dựng, không phải chữ ký số
# công cộng, không có giá trị pháp lý. Băm SHA-256, mã QR và cổng xác thực theo bản đã ký. Két khởi tạo trước F4.5 chưa
# có PKI thì ký số tự tắt, phát hành như cũ (docs/van-hanh.md mục Két bí mật). false: phát hành không ký, không gọi
# Transit, PKI
MOC_SIGN_ENABLED=true

# --- PostgreSQL (dữ liệu nghiệp vụ, Keycloak, Flowable — ba CSDL trong một máy chủ)
POSTGRES_DB=moc
POSTGRES_USER=moc
POSTGRES_PASSWORD=change_me
# CSDL keycloak và flowable được tạo ở lần khởi động đầu tiên (db/initdb/)
KEYCLOAK_DB_PASSWORD=change_me
FLOWABLE_DB_PASSWORD=change_me

# --- Keycloak — SSO (F1.1) ---------------------------------------------------
# Tài khoản quản trị realm master, chỉ dùng qua cổng nội bộ bên dưới (APISIX chặn /admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
# Trang quản trị Keycloak chỉ mở trên máy chủ: http://127.0.0.1:8180/admin
KEYCLOAK_ADMIN_PORT=8180
# Client moc-cli cho make seed / make smoke lấy token bằng mật khẩu kèm mã TOTP (hỏi mã theo đúng quy tắc của
# trình duyệt). Không cần trên server thật thì đặt false (đổi sau khi realm đã nạp: tắt client trong trang quản trị).
MOC_CLI_CLIENT_ENABLED=true
# Khóa bí mật của client svc-workflow (đọc danh bạ người dùng)
MOC_DIRECTORY_CLIENT_SECRET=change_me

# --- Hasura — dữ liệu có cấu trúc (F1.3) ------------------------------------
HASURA_ADMIN_SECRET=change_me
# Hasura gửi kèm khi gọi svc-workflow (Actions), để svc-workflow chỉ nhận yêu cầu từ Hasura
MOC_ACTION_SECRET=change_me

# --- Flowable — workflow (F1.4) ---------------------------------------------
FLOWABLE_ADMIN_PASSWORD=change_me
# Thời hạn mỗi bước (ISO 8601: ngày, giờ, phút, giây). Quá một thời hạn thì nhắc người phải làm, quá hai thì báo
# thêm lãnh đạo của họ. Thật PT24H, demo PT1M. Chỉ áp dụng cho văn bản trình hoặc vào sổ sau khi đổi.
MOC_SLA_DURATION=PT24H

# --- Centrifugo — thông báo realtime (F2.5) -----------------------------------
# Khóa HTTP API nội bộ: svc-workflow dùng để đẩy thông báo
CENTRIFUGO_API_KEY=change_me

# --- Thông báo qua email, webhook — svc-workflow (services/svc-workflow/README.md) ---------------------
# Ngoài chuông trên web, gửi thêm thông báo (việc mới, quá hạn, báo lãnh đạo…) qua email tới địa chỉ trong danh bạ
# và một tin tóm tắt lên webhook của kênh chat chung. Để trống MOC_SMTP_HOST và MOC_NOTIFY_WEBHOOK_URL thì tắt hẳn,
# như trước. Gửi ở nền, thử lại tối đa 5 lần: máy chủ thư hỏng không làm chậm hay hỏng việc xử lý văn bản.
# Máy chủ thư của đơn vị: MOC_SMTP_TLS=starttls (cổng 587), ssl (465) hoặc none (25, chỉ trong mạng nội bộ);
# MOC_SMTP_PORT để trống thì theo MOC_SMTP_TLS. Mật khẩu có ký tự $ thì viết $$
# none không bao giờ đăng nhập (mật khẩu sẽ đi dạng rõ): có MOC_SMTP_USER thì mọi thư email báo lỗi gửi
MOC_SMTP_HOST=
MOC_SMTP_PORT=
MOC_SMTP_TLS=starttls
MOC_SMTP_USER=
MOC_SMTP_PASSWORD=
# Người gửi, vd Signet <signet@ten-mien-cua-ban>; bắt buộc khi có MOC_SMTP_HOST
MOC_SMTP_FROM=
# Webhook nhận JSON {"text": …} (Mattermost, Slack) hoặc ntfy (MOC_NOTIFY_WEBHOOK_FORMAT=ntfy, URL kiểu
# https://ntfy.sh/<chủ-đề>). Tin trên webhook không có tên người, ý kiến, nội dung văn bản hạn chế. URL webhook thường
# chứa khóa: giữ như mật khẩu (két nạp như các bí mật khác)
MOC_NOTIFY_WEBHOOK_URL=
MOC_NOTIFY_WEBHOOK_FORMAT=json
# Chỉ gửi các loại này, cách nhau bằng dấu phẩy (để trống: mọi loại), vd chỉ webhook khi quá hạn và báo lãnh đạo:
# MOC_NOTIFY_WEBHOOK_KINDS=task.overdue,task.escalated. Loại: task.assigned, task.overdue, task.escalated,
# document.issued, document.processed, document.overdue, document.incoming, ot.alarm
MOC_NOTIFY_EMAIL_KINDS=
MOC_NOTIFY_WEBHOOK_KINDS=
# Demo không cần máy chủ thư thật: hộp thư thử Mailpit (profile mail) nhận mọi thư, không chuyển đi đâu, xem ở
# http://127.0.0.1:8025 — đặt MOC_EXTRA_PROFILES=mail, MOC_SMTP_HOST=mailpit, MOC_SMTP_PORT=1025, MOC_SMTP_TLS=none,
# MOC_SMTP_FROM=signet@moc.example
MOC_MAIL_UI_PORT=8025

# --- SeaweedFS — dữ liệu phi cấu trúc (F1.5) --------------------------------
SEAWEEDFS_S3_ACCESS_KEY=change_me
SEAWEEDFS_S3_SECRET_KEY=change_me
MOC_FILES_MAX_MB=25
# Văn bản hạn chế (F3.7): PDF nhiều trang hơn thì không nhận lúc tải lên, không đóng dấu người xem lúc mở. Mặc định 500
# MOC_RESTRICTED_MAX_PAGES=500
# Sổ kiểm toán (F2.12): svc-files chép đầu chuỗi ra bucket lạnh moc-cold có khóa ghi (S3 Object Lock) sau mỗi
# khoảng này (giây), nếu có dòng sổ mới. Mỗi mốc giữ ngần ấy ngày, trong hạn không ai xóa được, kể cả quản trị.
# Kiểm cả sổ: make audit
MOC_AUDIT_ANCHOR_INTERVAL_S=600
MOC_AUDIT_ANCHOR_RETENTION_DAYS=3650
# Nộp lưu (F3.8): mỗi khoảng này (giây) svc-files tìm hồ sơ đã đóng từ MOC_ARCHIVE_AFTER_DAYS ngày, ghi gói
# Parquet + tệp + manifest có băm vào bucket lạnh, rồi gỡ chi tiết khỏi CSDL. Thử ngay: make demo-nong-lanh
MOC_ARCHIVE_INTERVAL_S=3600
MOC_ARCHIVE_AFTER_DAYS=365
# Nạp lô văn bản đến (POST /api/imports/incoming): tổng byte một lô được ghi vào kho — cỡ đã giải nén của các tệp trong
# zip mà các dòng trỏ tới, mỗi lần trỏ tính một lần. Lô vượt trần bị từ chối ngay lúc gửi (413). Mặc định 200
# MOC_IMPORT_STORE_MAX_MB=200
# Phả hệ (F3.9): sự kiện OpenLineage của job nộp lưu luôn ghi vào core.lineage_events; đặt địa chỉ này thì gửi thêm tới
# máy chủ nhận OpenLineage, vd Marquez: http://marquez:5000/api/v1/lineage. Xem: make demo-pha-he
MOC_OPENLINEAGE_URL=

# --- Meilisearch — tìm kiếm (F1.7) ------------------------------------------
# Ít nhất 16 ký tự
MEILI_MASTER_KEY=change_me_at_least_16_chars

# --- Két bí mật — OpenBao (F3.2) --------------------------------------------
# Khóa mở két (static seal): két tự mở khi khởi động lại nhờ khóa này. Đổi sau khi két đã khởi tạo thì két không mở
# được nữa. Ai có khóa này cùng volume openbao_data là đọc được két. Các bí mật dịch vụ ở trên vẫn khai tại đây:
# két nạp lại chúng mỗi lần khởi động, svc-files và svc-workflow lấy từ két chứ không nhận qua biến môi trường.
MOC_OPENBAO_SEAL_KEY=change_me

# --- Sao lưu — restic (F3.4: make backup, make restore) ---------------------
# Khóa mã hóa kho sao lưu. MẤT KHÓA LÀ MẤT BẢN SAO LƯU: chép một bản tệp này ra ngoài máy chủ.
MOC_BACKUP_PASSWORD=change_me
# Thư mục kho trên máy chủ, tương đối thì tính từ thư mục chạy Signet. Nên trỏ sang ổ đĩa khác hoặc ổ mạng đã gắn
# vào máy chủ: kho nằm chung ổ với dữ liệu thì hỏng ổ là mất cả hai.
MOC_BACKUP_DIR=backups

# --- GitOps — reconciler (F3.3: scripts/reconcile.py, platform/systemd/) --------
# Bản sao git riêng của reconciler (đường dẫn tuyệt đối, ngoài thư mục chạy Signet). Có commit mới trên nhánh
# MOC_GITOPS_BRANCH thì reconciler dựng image và cài lại đúng commit đó vào thư mục chạy Signet (dừng khoảng một phút).
# Để trống: reconciler chỉ tự phục hồi (dựng lại dịch vụ mất container, đã dừng hoặc unhealthy).
# MOC_GITOPS_DIR=/opt/moc-src
# MOC_GITOPS_BRANCH=deploy
# Chỉ áp commit ký bằng khóa SSH có trong tệp này (định dạng allowed_signers của ssh-keygen, mỗi người một dòng:
# `email namespaces="git" ssh-ed25519 AAAA…`). Để trống: không kiểm chữ ký — ai đẩy được nhánh là cài được lên máy
# chủ. Cách ký và đẩy nhánh: docs/van-hanh.md mục GitOps
# MOC_GITOPS_ALLOWED_SIGNERS=/etc/moc/allowed_signers

# --- Dữ liệu mẫu (make seed) ------------------------------------------------
# Mật khẩu chung của các tài khoản mẫu (vanthu, truongkhoa, ...) — ít nhất 10 ký tự
MOC_DEMO_PASSWORD=change_me_demo
# Khóa TOTP chung mà make seed cài cho tài khoản mẫu văn thư, lãnh đạo, quản trị (đăng nhập trình duyệt bắt buộc
# mã). Xem mã hiện tại và khóa để thêm vào ứng dụng xác thực trên điện thoại: make totp
MOC_DEMO_TOTP_SECRET=change_me
