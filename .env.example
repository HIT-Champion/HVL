# =============================================================================
# DX-Lab — mẫu cấu hình môi trường
# Sao chép thành .env rồi chỉnh sửa:  cp .env.example .env
#
# LƯU Ý (tiêu chí PoF #4): mọi tham số cấu hình của DX-Lab đều nằm trong tệp này.
# Không bao giờ sửa trực tiếp vào mã nguồn hay tệp header để cấu hình hệ thống.
# =============================================================================

# --- Chung -------------------------------------------------------------------
DXLAB_ENV=development
DXLAB_DOMAIN=localhost
DXLAB_TIMEZONE=Asia/Ho_Chi_Minh

# --- [D] Không gian Dữ liệu — CSDL nền -------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dxlab
POSTGRES_USER=dxlab
POSTGRES_PASSWORD=change_me_before_deploy

# --- [H] Không gian Nhân sự -------------------------------------------------
# Cổng dịch vụ SSO / lưu trữ / wiki — điền sau khi chốt stack (docs/architecture.md)
H_SSO_PORT=8080
H_STORAGE_PORT=8081
H_WIKI_PORT=8082

# --- [P] Không gian Quy trình ------------------------------------------------
P_LOWCODE_PORT=8090
P_WORKFLOW_PORT=8091

# --- [D] Cổng dịch vụ BI ----------------------------------------------------
D_BI_PORT=8100

# --- [I] Không gian Trí tuệ Nhân tạo ----------------------------------------
I_VECTORDB_PORT=8110
I_AGENT_PORT=8111
# Khóa API mô hình ngôn ngữ (để trống nếu chạy mô hình cục bộ)
I_LLM_BASE_URL=
I_LLM_API_KEY=
