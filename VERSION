# gói — gói signet-1.2.0.tar.gz ghi v1.2.0 — nhờ dòng "VERSION export-subst" của .gitattributes; scripts/install.sh
# đọc dòng đó khi cài từ gói, scripts/kiem_goi.py kiểm nó trùng tên gói. Trong bản clone git dòng cuối giữ nguyên mẫu
