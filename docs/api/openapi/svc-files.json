{
  "openapi": "3.1.0",
  "info": {
    "title": "Mộc — svc-files",
    "description": "Tải tệp lên qua trạm kiểm dịch ClamAV, tải xuống theo quyền, tìm văn bản. Gọi qua cổng APISIX với token Bearer do Keycloak cấp (docs/api/README.md).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/files": {
      "post": {
        "summary": "Tải tệp lên: quét ClamAV, sạch mới lưu",
        "operationId": "upload_file_api_files_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileOut"
                }
              }
            }
          },
          "401": {
            "description": "Thiếu hoặc sai token"
          },
          "413": {
            "description": "Tệp vượt giới hạn MOC_FILES_MAX_MB"
          },
          "422": {
            "description": "Tệp chứa mã độc — đã chặn, không lưu, ghi vào sổ kiểm toán"
          },
          "503": {
            "description": "ClamAV, kho đối tượng hoặc CSDL không sẵn sàng — không lưu"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/files/{file_id}": {
      "get": {
        "summary": "Tải tệp xuống, nếu người gọi được xem tệp",
        "operationId": "download_file_api_files__file_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nội dung tệp, luôn ở dạng tải về",
            "content": {
              "application/octet-stream": {}
            }
          },
          "401": {
            "description": "Thiếu hoặc sai token"
          },
          "404": {
            "description": "Không có tệp, hoặc người gọi không được xem — hai trường hợp trả như nhau"
          },
          "503": {
            "description": "CSDL hoặc kho đối tượng không sẵn sàng"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Tìm văn bản theo số ký hiệu, trích yếu, cơ quan ban hành, nội dung",
        "operationId": "search_api_search_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Gõ có dấu hay không dấu đều được",
              "title": "Q"
            },
            "description": "Gõ có dấu hay không dấu đều được"
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "in",
                    "out"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Direction"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "received",
                    "registered",
                    "in_progress",
                    "done",
                    "draft",
                    "in_review",
                    "returned",
                    "approved",
                    "issued",
                    "archived",
                    "cancelled"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "type_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[^\\s/\"\\\\-]{1,10}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type Code"
            }
          },
          {
            "name": "urgency",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "normal",
                    "khan",
                    "thuong_khan",
                    "hoa_toc"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Urgency"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2100,
                  "minimum": 2000
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "`next_cursor` của trang trước",
              "title": "Cursor"
            },
            "description": "`next_cursor` của trang trước"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOut"
                }
              }
            }
          },
          "400": {
            "description": "Câu tìm trống, hoặc `cursor` sai, không phải của câu tìm này"
          },
          "401": {
            "description": "Thiếu hoặc sai token"
          },
          "503": {
            "description": "Meilisearch hoặc CSDL không sẵn sàng"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{document_id}/preview": {
      "get": {
        "summary": "Xem trước văn bản đi dưới dạng PDF đúng thể thức, chưa có số và mã xác thực",
        "operationId": "preview_document_api_documents__document_id__preview_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bản PDF in chữ DỰ THẢO",
            "content": {
              "application/pdf": {}
            }
          },
          "401": {
            "description": "Thiếu hoặc sai token"
          },
          "404": {
            "description": "Không có văn bản đi, hoặc người gọi không được đọc — hai trường hợp trả như nhau"
          },
          "409": {
            "description": "Văn bản đã phát hành: tải bản phát hành thay vì xem trước"
          },
          "503": {
            "description": "CSDL không sẵn sàng"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/registers/{direction}/{year}": {
      "get": {
        "summary": "Sổ đăng ký văn bản đến / đi của một năm, đúng các cột sẽ in",
        "operationId": "register_json_api_registers__direction___year__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "direction",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "in",
                "out"
              ],
              "type": "string",
              "description": "in: sổ văn bản đến; out: sổ văn bản đi",
              "title": "Direction"
            },
            "description": "in: sổ văn bản đến; out: sổ văn bản đi"
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 2100,
              "minimum": 2000,
              "title": "Year"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
