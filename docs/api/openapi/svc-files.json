                }
              }
            }
          },
          "401": {
            "description": "Thiếu hoặc sai token"
          },
          "403": {
            "description": "Chỉ văn thư và lãnh đạo đơn vị xem, in sổ đăng ký"
          },
          "503": {
            "description": "CSDL không sẵn sàng"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/registers/{direction}/{year}/pdf": {
      "get": {
        "summary": "In sổ đăng ký văn bản đến / đi của một năm ra PDF để ký nhận, đóng sổ (NĐ 30/2020, Điều 16, 22)",
        "operationId": "register_pdf_api_registers__direction___year__pdf_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "direction",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "in",
                "out"
              ],
              "type": "string",
              "description": "in: sổ văn bản đến; out: sổ văn bản đi",
              "title": "Direction"
            },
            "description": "in: sổ văn bản đến; out: sổ văn bản đi"
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 2100,
              "minimum": 2000,
              "title": "Year"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sổ A4 ngang: bìa, bảng theo mẫu, chỗ ký của văn thư",
            "content": {
              "application/pdf": {}
            }
          },
          "401": {
            "description": "Thiếu hoặc sai token"
          },
          "403": {
            "description": "Chỉ văn thư và lãnh đạo đơn vị xem, in sổ đăng ký"
          },
          "503": {
            "description": "CSDL không sẵn sàng"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/verify/{code}": {
      "get": {
        "summary": "Tra văn bản đã phát hành theo mã tra cứu in cạnh mã QR (không cần đăng nhập)",
        "operationId": "verify_by_code_api_verify__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 40,
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "valid: văn bản đã phát hành; not_found: không có văn bản nào khớp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyOut"
                }
              }
            }
          },
          "429": {
            "description": "Vượt giới hạn tra cứu theo địa chỉ IP (APISIX)"
          },
          "503": {
            "description": "CSDL không sẵn sàng"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/verify": {
      "get": {
        "summary": "Tra văn bản đã phát hành theo SHA-256 của tệp PDF (trình duyệt tự tính, không tải tệp lên)",
        "operationId": "verify_by_hash_api_verify_get",
        "parameters": [
          {
            "name": "sha256",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$",
              "description": "SHA-256 của tệp, 64 ký tự hex",
              "title": "Sha256"
            },
            "description": "SHA-256 của tệp, 64 ký tự hex"
          }
        ],
        "responses": {
          "200": {
            "description": "valid: văn bản đã phát hành; not_found: không có văn bản nào khớp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyOut"
                }
              }
            }
          },
          "429": {
            "description": "Vượt giới hạn tra cứu theo địa chỉ IP (APISIX)"
          },
          "503": {
            "description": "CSDL không sẵn sàng"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/case-files/{case_file_id}/archive": {
      "get": {
        "summary": "Phòng đọc: đọc lại gói lưu trữ của hồ sơ đã nộp lưu từ bucket lạnh, kiểm băm",
        "operationId": "case_file_archive_api_case_files__case_file_id__archive_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "case_file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Case File Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveOut"
                }
              }
            }
          },
          "404": {
            "description": "Không có hồ sơ, hoặc người gọi không được xem"
          },
          "409": {
            "description": "Hồ sơ chưa nộp lưu"
          },
          "502": {
            "description": "Gói trong bucket lạnh không khớp băm ghi trong CSDL"
          },
          "503": {
            "description": "Chưa đọc được CSDL hoặc bucket lạnh"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArchiveOut": {
        "properties": {
          "case_file_id": {
            "type": "string",
            "format": "uuid",
            "title": "Case File Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "closed_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed On"
          },
          "archived_at": {
            "type": "string",
            "format": "date-time",
            "title": "Archived At"
          },
          "archive_key": {
            "type": "string",
            "title": "Archive Key",
            "description": "Tiền tố của gói trong bucket lạnh (khóa ghi S3 Object Lock)"
          },
          "manifest_sha256": {
            "type": "string",
            "title": "Manifest Sha256",
            "description": "Băm manifest.json đọc từ bucket lạnh — đã so khớp với CSDL"
          },
          "retain_until": {
            "type": "string",
            "format": "date-time",
            "title": "Retain Until",
            "description": "Hạn giữ khóa ghi của gói"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/ArchivedDocumentOut"
            },
            "type": "array",
            "title": "Documents",
            "description": "Văn bản người gọi đọc được (cùng quy tắc như trước khi nộp lưu), đọc từ bảng Parquet trong gói (DuckDB)"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/ArchivedFileOut"
            },
            "type": "array",
            "title": "Files",
            "description": "Tệp của các văn bản trên"
          },
          "hidden": {
            "type": "integer",
            "title": "Hidden",
            "description": "Số văn bản trong gói người gọi không được đọc — chỉ biết có, không biết là gì"
          }
        },
        "type": "object",
        "required": [
          "case_file_id",
          "code",
          "title",
          "closed_on",
          "archived_at",
          "archive_key",
          "manifest_sha256",
          "retain_until",
          "documents",
          "files",
          "hidden"
        ],
        "title": "ArchiveOut"
      },
